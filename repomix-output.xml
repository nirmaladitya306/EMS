        e.preventDefault()
        onSubmit(form)
        setForm({ jobtitle: '', description: '' })
    }

    return (
        <div className="pg-modal-overlay">
            <div className="pg-modal">
                <div>
                    <div style={{
                        fontFamily: "'DM Serif Display', serif",
                        fontSize: '1.25rem', color: 'var(--rc-text-main, #0f172a)',
                        letterSpacing: '-0.02em', marginBottom: 4,
