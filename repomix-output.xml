            {/* ── Stats strip ── */}
            <div className="pg-stats" style={{ gridTemplateColumns: 'repeat(4, 1fr)' }}>
                {[
                    { label: 'Total',     value: total     },
                    { label: 'Pending',   value: pending   },
                    { label: 'Completed', value: completed },
