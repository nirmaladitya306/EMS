    // The position this one reports to (null = top of tree)
    reportsTo: {
        type: mongoose.Schema.Types.ObjectId,
        ref: 'Position',
        default: null
    },
    // Employees currently holding this position
    employees: [{
        type: mongoose.Schema.Types.ObjectId,
        ref: 'Employee'
    }],
    organizationID: {
        type: mongoose.Schema.Types.ObjectId,
        ref: 'Organization',
        required: true
    }
}, { timestamps: true })

PositionSchema.index({ organizationID: 1, level: 1 })
