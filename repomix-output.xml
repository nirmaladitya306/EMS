                    )}

                    {/* Filters */}
                    <div className="pg-filters">
                        <input
                            className="pg-search"
                            type="text"
                            placeholder="Search by employee name…"
                            value={search}
                            onChange={e => setSearch(e.target.value)}
                            style={{ minWidth: 240 }}
                        />
                        {['All', 'Eligible', 'Review Required', 'Ineligible'].map(s => (
                            <button
                                key={s}
                                className={`pg-pill${filterStatus === s ? ' active' : ''}`}
